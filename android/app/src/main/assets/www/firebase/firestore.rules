rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    // User is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User has verified Admin custom claim or admin record
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'finance_admin' ||
        request.auth.token.role == 'kyc_admin'
      );
    }

    // ========================================================================
    // 1. USERS & PROFILES
    // ========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can update their basic personal details, but cannot alter financial or status fields
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'kyc_status', 'wallet_balance'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ========================================================================
    // 2. WALLETS (STRICT CLIENT READ-ONLY)
    // Mobile/Web clients CANNOT write directly. Only Cloud Functions / Admin SDK can mutate balances.
    // ========================================================================
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Strict: Mutated ONLY via Cloud Functions / Admin SDK
    }

    // ========================================================================
    // 3. IMMUTABLE FINANCIAL TRANSACTIONS & LEDGER
    // Client can only read their own transactions. Writes are strictly through server/Cloud Functions.
    // ========================================================================
    match /wallet_transactions/{transactionId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if false; // Immutable Double-Entry Ledger
    }

    // ========================================================================
    // 4. DEPOSITS
    // Users can create pending deposit requests and read their own. Only Admin/Functions can approve.
    // ========================================================================
    match /deposits/{depositId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ========================================================================
    // 5. WITHDRAWALS
    // Client initiates via Cloud Function. Reads permitted for owner and admin.
    // ========================================================================
    match /withdrawals/{withdrawalId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if false; // Mutated strictly via Cloud Functions / Admin SDK
    }

    // ========================================================================
    // 6. INVESTMENT PLANS & ACTIVE INVESTMENTS
    // Plans are public read-only. Investments can only be created via Cloud Function.
    // ========================================================================
    match /investment_plans/{planId} {
      allow read: if true; // Public catalog
      allow write: if isAdmin();
    }

    match /investments/{investmentId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if false; // Mutated strictly via Cloud Functions (subscription / accruals)
    }

    // ========================================================================
    // 7. EARNINGS & ACCRUALS
    // ========================================================================
    match /earnings/{earningId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if false; // Produced solely by Daily Accruals Engine
    }

    // ========================================================================
    // 8. KYC DOCUMENTS & VERIFICATION
    // ========================================================================
    match /kyc/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && request.resource.data.status == 'pending') || isAdmin();
      allow delete: if false;
    }

    // ========================================================================
    // 9. REFERRALS & COMMISSIONS
    // ========================================================================
    match /referrals/{referralId} {
      allow read: if (isAuthenticated() && (resource.data.referrer_id == request.auth.uid || resource.data.referee_id == request.auth.uid)) || isAdmin();
      allow write: if false; // Computed server-side
    }

    // ========================================================================
    // 10. NOTIFICATIONS
    // ========================================================================
    match /notifications/{notificationId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if false; // Dispatched by Server / Cloud Functions
    }

    // ========================================================================
    // 11. SUPPORT TICKETS & CHAT
    // ========================================================================
    match /support_tickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
      
      match /messages/{messageId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.user_id == request.auth.uid) || isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // ========================================================================
    // 12. DIGITAL ASSETS (VDA) & CRYPTO BALANCES
    // ========================================================================
    match /digital_assets/{assetId} {
      allow read: if true; // Public asset listings & oracle prices
      allow write: if isAdmin();
    }

    // ========================================================================
    // 13. ADMINISTRATIVE CONTROLS, ROLES, AUDIT LOGS & SYSTEM SETTINGS
    // ========================================================================
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read, write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only via server Cloud Functions
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
